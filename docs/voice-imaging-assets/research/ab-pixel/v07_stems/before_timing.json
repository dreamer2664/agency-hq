{
  "lines": [
    {
      "i": 1,
      "text": "Night two, two fourteen again.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 0.6,
      "end": 2.995,
      "gap": 0.6
    },
    {
      "i": 2,
      "text": "Same flat, same speaker, nothing changed.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 4.4,
      "end": 7.91,
      "gap": 1.405
    },
    {
      "i": 3,
      "text": "Except the walls.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 7.97,
      "end": 9.25,
      "gap": 0.06
    },
    {
      "i": 4,
      "text": "And the door.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 9.31,
      "end": 10.09,
      "gap": 0.06
    },
    {
      "i": 5,
      "text": "And the kitchen.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 10.15,
      "end": 10.98,
      "gap": 0.06
    },
    {
      "i": 6,
      "text": "Six rooms in this flat.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 11.2,
      "end": 12.84,
      "gap": 0.22
    },
    {
      "i": 7,
      "text": "Six surfaces, six microphones.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 13.7,
      "end": 16.415,
      "gap": 0.86
    },
    {
      "i": 8,
      "text": "So I keep it loud, all night.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 16.475,
      "end": 18.725,
      "gap": 0.06
    },
    {
      "i": 9,
      "text": "The radio stays on.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 18.785,
      "end": 20.265,
      "gap": 0.06
    },
    {
      "i": 10,
      "text": "The kettle, twice an hour.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 20.325,
      "end": 22.17,
      "gap": 0.06
    },
    {
      "i": 11,
      "text": "A towel under the door.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 22.23,
      "end": 23.705,
      "gap": 0.06
    },
    {
      "i": 12,
      "text": "It isn't listening with a microphone any more.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 24.2,
      "end": 26.715,
      "gap": 0.495
    },
    {
      "i": 13,
      "text": "There are seven surfaces now.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 27.4,
      "end": 29.225,
      "gap": 0.685
    },
    {
      "i": 14,
      "text": "I stopped making noise.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 30.2,
      "end": 31.8,
      "gap": 0.975
    },
    {
      "i": 15,
      "text": "And the flat went quiet.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 32.8,
      "end": 34.405,
      "gap": 1.0
    },
    {
      "i": 16,
      "text": "And it was still listening.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 35.6,
      "end": 37.0,
      "gap": 1.195
    },
    {
      "i": 17,
      "text": "It heard the quiet.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 46.2,
      "end": 47.45,
      "gap": 9.2
    },
    {
      "i": 18,
      "text": "And the quiet was in the hall.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 49.6,
      "end": 51.245,
      "gap": 2.15
    },
    {
      "i": 19,
      "text": "Night two is over.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 52.4,
      "end": 53.685,
      "gap": 1.155
    },
    {
      "i": 20,
      "text": "Tomorrow, the quiet answers.",
      "rate": "-12%",
      "pitch": "-4Hz",
      "start": 55.6,
      "end": 57.775,
      "gap": 1.915
    }
  ],
